{
  "buildCommand": "echo 'Static site ready'",
  "outputDirectory": ".",
  "crons": [
    { "path": "/api/manter-ativo", "schedule": "0 12 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
